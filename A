function localToSelected() {
    const timeInput = document.getElementById("timeInput").value;
    const dateInput = document.getElementById("dateInput").value;
    const timezone = document.getElementById("timezone").value;
    const localTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    if (!timeInput || !dateInput) return;

    const [hours, minutes] = timeInput.split(":").map(Number);
    const [day, month, year] = dateInput.split(".").map(Number);

    // tworzymy moment w UTC
    const utcDate = new Date(Date.UTC(year, month - 1, day, hours, minutes));

    // czas w wybranej strefie
    const selectedDate = new Intl.DateTimeFormat("pl-PL", {
        timeZone: timezone,
        dateStyle: "full"
    }).format(utcDate);

    const selectedHour = new Intl.DateTimeFormat("pl-PL", {
        timeZone: timezone,
        timeStyle: "short"
    }).format(utcDate);

    // czas lokalny użytkownika
    const localDate = new Intl.DateTimeFormat("pl-PL", {
        timeZone: localTimezone,
        dateStyle: "full"
    }).format(utcDate);

    const localHour = new Intl.DateTimeFormat("pl-PL", {
        timeZone: localTimezone,
        timeStyle: "short"
    }).format(utcDate);

    document.querySelector("#localTimeText").innerHTML = "Czas lokalny:";
    document.querySelector("#selectedTimeText").innerHTML = "Wybrana strefa czasowa:";

    document.querySelector("#resultHour").innerHTML = selectedHour;
    document.querySelector("#resultDate").innerHTML = selectedDate;

    document.querySelector("#resultHourNow").innerHTML = localHour;
    document.querySelector("#resultDateNow").innerHTML = localDate;
}



